+int32_t mtmd_tokenize_video(mtmd_context * ctx,
+            mtmd_input_chunks * output,
+            const mtmd_input_text * text,
+            const mtmd_bitmap ** bitmaps,
+            size_t n_bitmaps,
+            const int32_t * temporal_positions,
+            size_t n_temporal_positions) {
+    if (!ctx->ctx_v) {
+        LOG_ERR("%s: model does not support vision input\n", __func__);
+        return 1;
+    }
+    if (n_bitmaps < 2) {
+        LOG_ERR("%s: video requires at least 2 frames, got %zu\n", __func__, n_bitmaps);
+        return 1;
+    }
+
+    const size_t n_superframes = n_bitmaps / 2; // drop last frame if odd
+    if (n_temporal_positions != n_superframes) {
+        LOG_ERR("%s: temporal_positions count (%zu) must equal n_bitmaps/2 (%zu)\n",
+                __func__, n_temporal_positions, n_superframes);
+        return 1;
+    }
+
+    // Split text at media marker
+    std::string input_text = text->text;
+    // convert legacy image marker to media marker
+    string_replace_all(input_text, MTMD_DEFAULT_IMAGE_MARKER, ctx->media_marker);
+
+    auto parts = mtmd_tokenizer::split_text(input_text, ctx->media_marker);
+    size_t n_markers = 0;
+    for (auto & p : parts) {
+        if (p == ctx->media_marker) n_markers++;
+    }
+    if (n_markers != 1) {
+        LOG_ERR("%s: video expects exactly 1 media marker, got %zu\n", __func__, n_markers);
+        return 1;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(ctx->text_model);
+
+    // Preprocess frame pairs into super-frames
+    clip_image_f32_batch video_batch;
+    video_batch.is_video = true;
+
+    for (size_t i = 0; i < n_superframes; i++) {
+        const mtmd_bitmap * bm_a = bitmaps[i * 2];
+        const mtmd_bitmap * bm_b = bitmaps[i * 2 + 1];
+
+        // Convert bitmaps to clip_image_u8
+        clip_image_u8_ptr img_a(clip_image_u8_init());
+        img_a->nx = bm_a->nx;
+        img_a->ny = bm_a->ny;
+        img_a->buf.resize(bm_a->data.size());
+        std::memcpy(img_a->buf.data(), bm_a->data.data(), bm_a->data.size());
+
+        clip_image_u8_ptr img_b(clip_image_u8_init());
+        img_b->nx = bm_b->nx;
+        img_b->ny = bm_b->ny;
+        img_b->buf.resize(bm_b->data.size());
+        std::memcpy(img_b->buf.data(), bm_b->data.data(), bm_b->data.size());
+
+        // Preprocess each frame (resize + normalize)
+        clip_image_f32_batch batch_a, batch_b;
+        if (!clip_image_preprocess(ctx->ctx_v, img_a.get(), &batch_a)) {
+            LOG_ERR("%s: failed to preprocess frame %zu\n", __func__, i * 2);
+            return 2;
+        }
+        if (!clip_image_preprocess(ctx->ctx_v, img_b.get(), &batch_b)) {
+            LOG_ERR("%s: failed to preprocess frame %zu\n", __func__, i * 2 + 1);
+            return 2;
+        }
+
+        // Both frames should have been resized to the same dimensions
+        auto & f32_a = batch_a.entries[0];
+        auto & f32_b = batch_b.entries[0];
+        GGML_ASSERT(f32_a->nx == f32_b->nx && f32_a->ny == f32_b->ny);
+
+        const int nx = f32_a->nx;
+        const int ny = f32_a->ny;
+        const int n_pixels = nx * ny;
+
+        // Merge two 3-channel HWC images into one 6-channel HWC super-frame
+        clip_image_f32_ptr super_frame(clip_image_f32_init());
+        super_frame->nx = nx;
+        super_frame->ny = ny;
+        super_frame->buf.resize(n_pixels * 6);
+
+        for (int p = 0; p < n_pixels; p++) {
+            super_frame->buf[p * 6 + 0] = f32_a->buf[p * 3 + 0];
+            super_frame->buf[p * 6 + 1] = f32_a->buf[p * 3 + 1];
+            super_frame->buf[p * 6 + 2] = f32_a->buf[p * 3 + 2];
+            super_frame->buf[p * 6 + 3] = f32_b->buf[p * 3 + 0];
+            super_frame->buf[p * 6 + 4] = f32_b->buf[p * 3 + 1];
+            super_frame->buf[p * 6 + 5] = f32_b->buf[p * 3 + 2];
+        }
+
+        video_batch.entries.push_back(std::move(super_frame));
+    }
+
+    // Create video image_tokens
+    mtmd_image_tokens_ptr image_tokens(new mtmd_image_tokens);
+    image_tokens->nx = clip_n_output_tokens_x(ctx->ctx_v, video_batch.entries[0].get());
+    image_tokens->ny = clip_n_output_tokens_y(ctx->ctx_v, video_batch.entries[0].get());
+    image_tokens->nt = n_superframes;
+    image_tokens->use_mrope_pos = true;
+    image_tokens->temporal_positions.assign(temporal_positions,
+                                             temporal_positions + n_temporal_positions);
+    image_tokens->batch_f32 = std::move(video_batch);
+    image_tokens->id = "video";
+
+    LOG_DBG("%s: video nx=%d ny=%d nt=%d n_tokens=%d\n", __func__,
+            image_tokens->nx, image_tokens->ny, image_tokens->nt,
+            image_tokens->n_tokens());
+
+    // Build output chunks: text + VIDEO + text
+    mtmd_input_chunks result;
+
+    auto add_text_chunk = [&](const std::vector<llama_token> & tokens) {
+        if (tokens.empty()) return;
+        if (!result.entries.empty()
+            && result.entries.back().type == MTMD_INPUT_CHUNK_TYPE_TEXT) {
+            auto & back = result.entries.back().tokens_text;
+            back.insert(back.end(), tokens.begin(), tokens.end());
+        } else {
+            result.entries.push_back({
+                MTMD_INPUT_CHUNK_TYPE_TEXT,
+                tokens,
+                nullptr,
+                nullptr,
+            });
+        }
+    };
+
+    for (auto & part : parts) {
+        if (part == ctx->media_marker) {
+            // Add vision begin token
+            if (!ctx->img_beg.empty()) {
+                auto tokens = mtmd_tokenizer::mtmd_tokenize_text_internal(
+                    vocab, ctx->img_beg, false, true);
+                add_text_chunk(tokens);
+            }
+
+            // Add VIDEO chunk
+            result.entries.push_back({
+                MTMD_INPUT_CHUNK_TYPE_VIDEO,
+                {},
+                std::move(image_tokens),
+                nullptr,
+            });
+
+            // Add vision end token
+            if (!ctx->img_end.empty()) {
+                auto tokens = mtmd_tokenizer::mtmd_tokenize_text_internal(
+                    vocab, ctx->img_end, false, true);
+                add_text_chunk(tokens);
+            }
+        } else {
+            auto tokens = mtmd_tokenizer::mtmd_tokenize_text_internal(
+                vocab, part, false, text->parse_special);
+            add_text_chunk(tokens);
+        }
+    }
+
+    // Handle BOS
+    if (text->add_special && llama_vocab_get_add_bos(vocab)) {
+        if (!result.entries.empty()
+            && result.entries[0].type == MTMD_INPUT_CHUNK_TYPE_TEXT) {
+            result.entries[0].tokens_text.insert(
+                result.entries[0].tokens_text.begin(), llama_vocab_bos(vocab));
+        } else {
+            mtmd_input_chunk bos_chunk{
+                MTMD_INPUT_CHUNK_TYPE_TEXT,
+                {llama_vocab_bos(vocab)},
+                nullptr,
+                nullptr,
+            };
+            result.entries.insert(result.entries.begin(), std::move(bos_chunk));
+        }
+    }
+
+    // Handle EOS
+    if (text->add_special && llama_vocab_get_add_eos(vocab)) {
+        add_text_chunk({llama_vocab_eos(vocab)});
+    }
+
+    *output = std::move(result);
+    return 0;
+}
