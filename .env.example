# llama-video environment configuration
# Copy to .env and customize

# llama-server connection
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_SERVER_TIMEOUT=120
LLAMA_SERVER_MAX_RETRIES=3

# Frame extraction
LLAMA_VIDEO_FFMPEG_PATH=ffmpeg
LLAMA_VIDEO_DEFAULT_FPS=2.0
LLAMA_VIDEO_MAX_FRAMES=64

# Python API service
LLAMA_VIDEO_HOST=0.0.0.0
LLAMA_VIDEO_PORT=9000
LLAMA_VIDEO_LOG_LEVEL=INFO
LLAMA_VIDEO_DEBUG=0
